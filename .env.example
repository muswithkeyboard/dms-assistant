# Скопировать в .env (не в git). Ключи моделей читает только src/dms_core/llm/ (ADR 0002).
DMS_HOST=127.0.0.1
DMS_PORT=8080
# DMS_ALLOWED_HOSTS=dms.example.ru,10.0.0.5  # имена сайта сверх 127.0.0.1/localhost/[::1] (Host; иначе 403)
# DMS_DATA_DIR=/abs/path/to/data          # по умолчанию <app>/data (ссылка на ../data)
# DMS_WARM=1                              # прогрев индексов договоров при старте (0 — при первом вопросе)
# DMS_CLAUSE_CACHE_MAX=200000             # пунктов в памяти; ГК из 100 договоров — 1000000 (~1 ГБ, ответ 2–4 с)
# DMS_LLM_PROVIDER=anthropic              # anthropic | openai_compat | gigachat | mock; пусто — без модели
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GIGACHAT_CREDENTIALS=
# Локальная открытая модель через Ollama (OpenAI-совместимый адрес), без платного ключа:
# DMS_LLM_PROVIDER=openai_compat
# DMS_LLM_MODEL=qwen3:8b
# DMS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# DMS_LLM_REASONING=none                  # без «размышлений»: в разы быстрее на слабом железе
# Модель-помощник (assist.py): понимает вопросы своими словами; ответ всё равно строит код по документам.
# Ollama: `ollama pull qwen3:1.7b`; из Docker — http://host.docker.internal:11434/v1
# DMS_ENGINE_MODE=guided
# DMS_LLM_PROVIDER=openai_compat
# DMS_LLM_MODEL=qwen3:1.7b
# DMS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# DMS_LLM_REASONING=none                  # без «размышлений»: меньше секунды на вопрос вместо минуты
# DMS_LLM_SMALL=1
# DMS_LLM_ASSIST=0                        # выключить помощника, оставив модель
# DMS_LLM_ASSIST_PAUSE=300                # после сбоя модели помощник молчит N секунд (не ждёт таймаут на каждом вопросе)

