# Скопировать в deploy/.env (install.sh делает это сам).
DMS_DOMAIN=dms.example.ru          # домен, A-запись которого указывает на этот сервер
# DMS_DATA_HOME=../data            # где лежат raw/ (комплект) и models/ (энкодер)
# DMS_MEM_LIMIT=2g                 # лимит памяти сервиса
# DMS_CLAUSE_CACHE_MAX=200000      # пунктов в памяти; при 4 ГБ и больших ГК — 1000000
